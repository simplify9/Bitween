<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SW.Bitween.Adapters.Db.PostgreSql</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="8.1.23" />
    <!-- Pinned to the 8.x line: the adapter targets net8.0, and Npgsql 9 wants net9.0 upwards. -->
    <PackageReference Include="Npgsql" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SW.Bitween.Adapters.Db.Core/SW.Bitween.Adapters.Db.Core.csproj" />
  </ItemGroup>

</Project>
