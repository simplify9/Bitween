<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>SW.Bitween.Adapters.Bus.Sqs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" Version="3.7.400.87" />
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="8.1.23" />
  </ItemGroup>
  <ItemGroup>
    <!-- The settings contract is source, not a package: adapters target net8.0 while the rest of
         the solution is on net10.0, and Bitween matches these attributes by name anyway. -->
    <Compile Include="..\SW.Bitween.Adapters.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
